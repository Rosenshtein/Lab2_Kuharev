{
    "alphabet": [
        "1",
        "X",
        "#",
        "C",
        "c",
        "x",
        "P",
        "Y",
        "N"
    ],
    "states": {
        "qHALT": {
            "1": "!",
            "X": "!",
            "#": "!",
            "C": "!",
            "c": "!",
            "x": "!",
            "P": "!",
            "Y": "!",
            "N": "!",
            "λ": "!",
            "comment": "Остановка."
        },
        "q0": {
            "1": "1 R q_check_second",
            "comment": "Начальное состояние. Если встречаем '1', идем вправо в q_check_second."
        },
        "q_check_second": {
            "1": "1 R q_divide_first",
            "#": "P R q_divide_first",
            "comment": "Если встречаем '1', идем вправо в q_divide_first. Если #, записываем P и переходим в q_divide_first."
        },
        "q_divide_first": {
            "1": "C R q_divide_second",
            "comment": "Ищем первый делитель. Если 1, заменяем на C и идем вправо в q_divide_second."
        },
        "q_divide_second": {
            "1": "c R q_check_division",
            "#": "P R q_check_division",
            "comment": "Переходим к проверке деления. Если встречаем 1, заменяем на c и идем вправо в q_check_division."
        },
        "q_check_division": {
            "1": "1 R q0",
            "P": "P R q_check_first",
            "comment": "Если 1, возвращаемся в q0. Если P, идем в q_check_first."
        },
        "q_check_first": {
            "1": "1 R q_check_second",
            "#": "P R q_accept",
            "comment": "Проверяем на делимость, если #, переходим в q_accept."
        },
        "q_accept": {
            "_": "Y R qHALT",
            "comment": "Если все завершено, записываем Y и останавливаем."
        },
        "q_reject": {
            "_": "N R qHALT",
            "comment": "Если число составное, записываем N и останавливаем."
        }
    },
    "initial_state": "q0",
    "accepting_state": "q_accept",
    "rejecting_state": "q_reject"
}
